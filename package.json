{
  "name": "meals",
  "version": "0.1.0",
  "private": true,
  "description": "Weekly family meal planner for the home network",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "biome check --write .",
    "lint": "biome ci . && shellcheck scripts/*.sh scripts/lib/*.sh scripts/meals-* test/stubs/*",
    "start": "node server/index.js",
    "test": "node --test --disable-warning=ExperimentalWarning --test-timeout=10000 test/*.test.js",
    "test:host": "scripts/host-smoke.sh meals:test",
    "test:image": "docker build --tag meals:test . && scripts/image-smoke.sh meals:test"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "happy-dom": "20.14.5",
    "supertest": "^7.3.0"
  }
}
