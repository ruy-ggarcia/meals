{
  "name": "meals",
  "version": "0.3.0",
  "private": true,
  "description": "Self-hosted weekly family meal planner",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "biome check --write .",
    "lint": "scripts/install-lint-tools.sh && biome ci . && shellcheck scripts/*.sh scripts/lib/*.sh scripts/meals-* test/stubs/* && .tools/bin/actionlint && .tools/bin/hadolint Dockerfile",
    "start": "node server/index.js",
    "test": "node --test --disable-warning=ExperimentalWarning --test-timeout=10000 test/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
    "test:host": "scripts/host-smoke.sh meals:test",
    "test:image": "docker build --tag meals:test . && scripts/image-smoke.sh meals:test",
    "test:units": "scripts/units-check.sh",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json && tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "happy-dom": "21.0.4",
    "supertest": "^7.3.1",
    "typescript": "7.0.2"
  }
}
