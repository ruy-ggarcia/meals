{
  "name": "meals",
  "version": "0.4.0",
  "private": true,
  "description": "Self-hosted weekly family meal planner",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "biome check --write .",
    "lint": "biome ci . && shellcheck scripts/*.sh scripts/lib/*.sh scripts/meals-* test/stubs/*",
    "start": "node server/index.js",
    "test": "node --test --disable-warning=ExperimentalWarning --test-timeout=10000 test/*.test.js",
    "test:host": "scripts/host-smoke.sh meals:test",
    "test:image": "docker build --tag meals:test . && scripts/image-smoke.sh meals:test",
    "test:units": "scripts/units-check.sh"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "happy-dom": "21.0.1",
    "supertest": "^7.3.1"
  }
}
